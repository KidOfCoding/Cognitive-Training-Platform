# ==============================================================================
# Cognitive Training Platform - Environment Variables Template
# Copy this file to .env and configure the values for local development.
# For production on Vercel, set these in Project Settings > Environment Variables.
# ==============================================================================

# --- CLERK AUTHENTICATION ---
# Required: Clerk Publishable Key (used by frontend Vite client)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MONGODB ATLAS DATABASE ---
# Required: MongoDB Connection URI (used by serverless API functions)
# Note: Both MONGODB_URI and MONGO_URL are supported by the backend
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- RAZORPAY PAYMENT GATEWAY ---
# Required: Razorpay API Key ID and Key Secret for purchasing plays
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- GAME CHANCE CONFIGURATION ---
# Optional: Free attempts allocated per game upon account creation (Default: 1)
FREE_CHANCES=1
VITE_FREE_CHANCES=1

# Optional: Paid attempts credited to all games per recharge pack (Default: 7)
PAID_CHANCES=7
VITE_PAID_CHANCES=7

# Optional: Price in INR for the recharge pack (Default: 25)
PAID_CHANCES_PRICE=25
VITE_PAID_CHANCES_PRICE=25

# --- COLLEGE EMAIL POLICY ---
# Optional: Toggle variable. If set to 1, allows all accredited universities/colleges (.edu, .ac.in, etc.)
# If set to 0, strictly restricts access to only the domains/emails in ALLOWED_EMAIL_DOMAINS
ALLOW_ALL_COLLEGES=0
VITE_ALLOW_ALL_COLLEGES=0

# Optional: Comma-separated allowed college email domains or specific email IDs (e.g. cgu-odisha.ac.in, othercollege.edu)
ALLOWED_EMAIL_DOMAINS=cgu-odisha.ac.in
VITE_ALLOWED_EMAIL_DOMAINS=cgu-odisha.ac.in

# --- ADMIN DASHBOARD ACCESS ---
# Required: Password for accessing the admin operations dashboard at /admin.html
ADMIN_PASSWORD=admin@cognitive2026

# --- CLOUDINARY MEDIA STORAGE ---
# Optional: Credentials for photo proof uploads in grievances & refund requests
# If not provided, proofs will be saved directly via data-URLs
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively, provide full URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

